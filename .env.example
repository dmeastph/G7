# Firebase web app config — from Firebase Console > Project Settings > General.
# Not secret (it's shipped to the browser), but keep it out of git so each
# environment (dev/prod Firebase project) can differ without a commit.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to connect to local Firebase emulators instead of the live
# project. vite.config picks this up via import.meta.env in dev only.
VITE_USE_EMULATORS=true

# The station account's own branch — burned into the tablet's env at setup,
# not something the app should ever ask the user to type in.
VITE_STATION_BRANCH_ID=001
