{
  "name": "g7-ops",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint .",
    "emulators": "firebase emulators:start --import=./.emulator-data --export-on-exit",
    "test:rules": "vitest run tests/",
    "seed": "tsx scripts/seed.ts",
    "seed-equipment": "tsx scripts/seedEquipment.ts",
    "set-owner": "tsx scripts/setOwnerClaim.ts",
    "setup-station": "tsx scripts/setupStation.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "firebase": "^11.0.2",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "firebase-admin": "^12.7.0",
    "firebase-tools": "^13.24.1",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.5"
  }
}
